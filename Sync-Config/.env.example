# Shared sync settings for Python scrapers (source URLs, start dates, optional API keys).
# Copy to .env and adjust as needed.

# TN government portal source URLs (not stored in JSON tables)
TN_GOV_BASE_URL=https://www.tn.gov.in/
TN_DEPT_SOURCE_URL=https://www.tn.gov.in/department_list.php
TN_MINISTERS_SOURCE_URL=https://www.tn.gov.in/minister_list.php
TN_DISTRICTS_SOURCE_URL=https://www.tn.gov.in/district_list.php
TN_GO_DEPT_SOURCE_URL=https://www.tn.gov.in/godept_list.php
TN_GO_START_DATE=10-05-2026
TN_PRESS_RELEASE_SOURCE_URL=https://dipr.tn.gov.in/press-release1.html
TN_PRESS_RELEASE_START_DATE=10-05-2026
TN_GOV_PRESS_RELEASE_SOURCE_URL=https://www.tn.gov.in/press_release.php
TN_GOV_PRESS_RELEASE_START_DATE=10-05-2026
TVA_MAGAZINE_SOURCE_URL=https://tamildigitallibrary.in/book-search-new?sub_cat_id=36&cat_id=21&sub_cat_name=%E0%AE%A4%E0%AE%AE%E0%AE%BF%E0%AE%B4%E0%AE%B0%E0%AE%9A%E0%AF%81
TN_IAS_TRANSFERS_POSTINGS_SOURCE_URL=https://tnsectdemo.tn.gov.in/ias/transferandpostings.php
TN_IAS_TRANSFERS_POSTINGS_START_DATE=10-05-2026

# NewsData.io API key (https://newsdata.io/register) — used by TN-News fetch script
NEWSDATA_API_KEY=your-newsdata-api-key-here
